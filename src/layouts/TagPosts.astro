---
import { type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Footer from "@components/Footer.astro";
import Card from "@components/Card";
import Pagination from "@components/Pagination.astro";
import { SITE } from "@config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl, toLang, useTranslations } from "@i18n/utils";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
  tag: string;
  tagName: string;
}

const { currentPage, totalPages, paginatedPosts, tag, tagName } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={`${t("tag.title")} ${tagName} | ${SITE.title}`}>
  <Main
    pageTitle={[t("tag.title"), tagName]}
    titleTransition={tag}
    pageDesc={`${t("tag.desc")} "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {
        paginatedPosts.map(post => (
          <Card href={getPostUrl(post)} frontmatter={post.data} lang={lang} />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={getRelativeLocaleUrl(
      lang,
      `tags/${tag}${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}`
    )}
    nextUrl={getRelativeLocaleUrl(lang, `tags/${tag}/${currentPage + 1}`)}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
