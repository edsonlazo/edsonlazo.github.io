---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { SITE } from "@config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl, toLang, useTranslations } from "@i18n/utils";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={`${t("posts.title")} | ${SITE.title}`}>
  <Main pageTitle={t("posts.title")} pageDesc={t("posts.desc")}>
    <ul>
      {
        paginatedPosts.map(post => (
          <Card href={getPostUrl(post)} frontmatter={post.data} lang={lang} />
        ))
      }
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={getRelativeLocaleUrl(
      lang,
      `posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}`
    )}
    nextUrl={getRelativeLocaleUrl(lang, `posts/${currentPage + 1}`)}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
