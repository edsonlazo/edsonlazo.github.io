---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import SiteLinks from "@components/SiteLinks.astro";
import Card from "@components/Card";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
---

<Layout>
  <main id="main-content">
    <h1>{SITE.title}</h1>
    <p class="intro">
      Backend developer from Bolivia, writing about software and whatever I'm
      learning.
    </p>
    <SiteLinks showHome={false} />

    <ul>
      {
        sortedPosts.map(({ data, slug }) => (
          <Card href={`/posts/${slug}/`} frontmatter={data} />
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12 pt-12 sm:pt-16;
  }
  h1 {
    @apply text-3xl font-semibold;
  }
  .intro {
    @apply mb-3 mt-3 opacity-80;
  }
  ul {
    @apply mt-8;
  }
</style>
