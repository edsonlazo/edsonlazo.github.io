---
import { getRelativeLocaleUrl } from "astro:i18n";
import { SITE } from "@config";
import { DEFAULT_LANG } from "@i18n/ui";

// Every page lives under a language, so "/" just sends visitors to the default one.
// Written by hand because Astro.redirect waits 2 seconds on static sites.
// Relative so it stays on the current host (localhost in dev)
const target = getRelativeLocaleUrl(DEFAULT_LANG);
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="UTF-8" />
    <title>{SITE.title}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href={target}>{target}</a>
  </body>
</html>
