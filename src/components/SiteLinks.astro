---
import { SOCIALS } from "@config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { toLang, useTranslations } from "@i18n/utils";

export interface Props {
  showHome?: boolean;
}

const { showHome = true } = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const links = [
  ...(showHome
    ? [{ name: t("nav.home"), href: getRelativeLocaleUrl(lang) }]
    : []),
  { name: t("nav.about"), href: getRelativeLocaleUrl(lang, "about") },
  { name: "RSS", href: "/rss.xml" },
  ...SOCIALS.filter(social => social.active).map(({ name, href }) => ({
    name: name === "Mail" ? t("nav.email") : name,
    href,
  })),
];
---

<nav aria-label="Site">
  {
    links.map(({ name, href }, index) => (
      <>
        {index > 0 && <span aria-hidden="true">·</span>}
        <a href={href}>{name}</a>
      </>
    ))
  }
</nav>

<style>
  nav {
    @apply flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm opacity-70;
  }
  nav a {
    @apply underline decoration-1 underline-offset-4 hover:text-skin-accent;
  }
</style>
